<% layout("/layout/boilerplate") %>
<body>
    <h2>Listing Dettails</h2>

        <h4> <%= listing.title %>  </h4>
        <img src="<%= listing.image.url %>" alt="image">
        <p><%= listing.description %> <br> Price : &#8377;<%= listing.price.toLocaleString("en-IN") %> <br> <%= listing.location %> <br> <%= listing.country %></p>

        <a href="/listing/edit/<%= listing._id %>">Edit </a> 
        <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST" >
            <button>Delete</button>
        </form>
</body>