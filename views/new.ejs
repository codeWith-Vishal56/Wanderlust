<% layout("/layout/boilerplate") %>
<body>
  <div class="row mt-5">
    <div class="col col-8 offset-2">
      <h2>Add New Listing</h2>
      <form action="/listing" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label class="form-label" for="title">Title</label>
          <input
            class="form-control"
            type="text"
            id="title"
            name="listing[title]"
            placeholder="Enter listing title"
            required
          />
          <div class="valid-feedback">Looks Good!</div>
          <div class="invalid-feedback">Please enter a Title.</div>
        </div>

        <div class="mb-3">
          <label class="form-label" for="description">Description</label>
          <textarea
            class="form-control"
            id="description"
            name="listing[description]"
            placeholder="Describe your property"
            required
          ></textarea>
          <div class="valid-feedback">Looks Good!</div>
          <div class="invalid-feedback">Please enter Listing Description</div>
        </div>

        <div class="mb-3">
          <label class="form-label" for="image">Image URL</label>
          <input
            class="form-control"
            type="text"
            id="image"
            name="listing[image][url]"
            placeholder="https://example.com/image.jpg"
          />
          <div class="valid-feedback">Looks Good!</div>
          <div class="invalid-feedback">Please enter a valid image url</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label class="form-label" for="price">Price</label>
            <input
              class="form-control"
              type="number"
              id="price"
              name="listing[price]"
              placeholder="2500"
              required
            />
            <div class="valid-feedback">Looks Good!</div>
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>

          <div class="mb-3 col-md-8">
            <label class="form-label" for="location">Location</label>
            <input
              class="form-control"
              type="text"
              id="location"
              name="listing[location]"
              placeholder="e.g. Manali"
              required
            />
            <div class="valid-feedback">Looks Good!</div>
            <div class="invalid-feedback">Please enter listing location</div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label" for="country">Country</label>
          <input
            class="form-control"
            type="text"
            id="country"  
            name="listing[country]"
            placeholder="e.g. India"
            required
          />
          <div class="valid-feedback">Looks Good!</div>
          <div class="invalid-feedback">Please enter Listing Country.</div>
        </div>

        <div class="mb-3">
          <button type="submit" class="btn btn-dark form-btn">Add</button>
        </div>
      </form>
    </div>
  </div>
</body>
