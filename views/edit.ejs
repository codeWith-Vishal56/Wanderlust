<% layout("/layout/boilerplate") %>

<body>
  <div class="row mt-5">
    <div class="col col-8 offset-2">
      <form action="/listing/<%= listing._id %>?_method=PUT" method="POST">
        <h2>Edit Your Listing</h2>

        <div class="mb-3">    
          <label class="form-label" for="title">Title :</label>
          <input
            class="form-control"
            type="text"
            name="listing[title]"
            value="<%= listing.title %>"
            id="title"
          />
        </div>

        <div class="mb-3">
          <label class="form-label" for="description"> Description :</label>
          <textarea
            class="form-control"
            type="text" 
            name="listing[description]"
            id="description"
          >
          <%= listing.description %>
          </textarea>
        </div>

        <div class="mb-3">
          <label class="form-label" for="url"> url :</label>
          <input
            class="form-control"
            type="text"
            name="listing[image][url]"
            value="<%= listing.image.url %>"
            id="url"
          />
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label class="form-label" for="price"> price :</label>
            <input
              class="form-control"
              type="number"
              name="listing[price]"
              value="<%= listing.price %>"
              id="price"
            />
          </div>

          <div class="mb-3 col-md-8">
            <label class="form-label" for="country"> country :</label>
            <input
              class="form-control"
              type="text"
              name="listing[country]"
              value="<%= listing.country %>"
              id="country"
            />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label" for="location"> location :</label>
          <input
            class="form-control"
            type="text"
            name="listing[location]"
            value="<%= listing.location %>"
            id="location"
          />
        </div>
        <div class="mb-3">
        <button type="submit" class="btn btn-dark form-btn mb-3">Edit</button>
        </div>
      </form>
    </div>
  </div>
</body>
