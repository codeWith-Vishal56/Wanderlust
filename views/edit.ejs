<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing</title>
</head>
<body>
    <h2>Edit Your Listing</h2>
    <form action="/listing/<%= listing._id %>?_method=PUT" method="POST" >
        <label for="title">Title :</label>
        <input type="text" name="title" value="<%= listing.title %>" id="title">
<br><br>
        <label for="description"> Description :</label>
        <input type="text" name="description" value="<%= listing.description %>" id="description">
 <br><br>
        <label for="url"> url :</label>
        <input type="text" name="url" value="<%= listing.image.url %>" id="url">
<br><br>
        <label for="price"> price :</label>
        <input type="number" name="price" value="<%= listing.price %>" id="price">
<br><br>
        <label for="location"> location :</label>
        <input type="text" name="location" value="<%= listing.location %>" id="location">
<br><br>
        <label for="country"> country :</label>
        <input type="text" name="country" value="<%= listing.country %>" id="country">

        <br><br>
        
  <input type="submit" value="Edit">
    </form>
</body>
</html>