<% layout("/layout/boilerplate") %>

<body>
    <h2>Edit Your Listing</h2>
   <form action="/listing/<%= listing._id %>?_method=PUT" method="POST" >
        <label for="title">Title :</label>
        <input type="text" name="listing[title]" value="<%= listing.title %>" id="title">
<br><br>
        <label for="description"> Description :</label>
        <input type="text" name="listing[description]" value="<%= listing.description %>" id="description">
 <br><br>
        <label for="url"> url :</label>
        <input type="text" name="listing[url]" value="<%= listing.image.url %>" id="url">
<br><br>
        <label for="price"> price :</label>
        <input type="number" name="listing[price]" value="<%= listing.price %>" id="price">
<br><br>
        <label for="location"> location :</label>
        <input type="text" name="listing[location]" value="<%= listing.location %>" id="location">
<br><br>
        <label for="country"> country :</label>
        <input type="text" name="listing[country]" value="<%= listing.country %>" id="country">

        <br><br>
        
  <input type="submit" value="Edit">
</form>
</body>